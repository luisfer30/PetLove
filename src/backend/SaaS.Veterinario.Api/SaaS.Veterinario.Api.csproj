<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>c80b4675-8271-4d5e-b844-33a38e73dd21</UserSecretsId>
    <!-- Sobrescribe el InvariantGlobalization=true global (Directory.Build.props): la Etapa 8
         necesita resolver zonas horarias IANA (ej. America/Guayaquil) via TimeZoneInfo, lo cual
         requiere ICU. En modo invariante esto falla en Windows con TimeZoneNotFoundException.
         En Linux funciona igual porque lee tzdata del sistema operativo directamente, pero no
         debemos depender de esa diferencia de plataforma ni de variables de entorno manuales. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin transitivo: Microsoft.OpenApi 2.0.0 tiene una vulnerabilidad conocida (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SaaS.Veterinario.Application\SaaS.Veterinario.Application.csproj" />
    <ProjectReference Include="..\SaaS.Veterinario.Infrastructure\SaaS.Veterinario.Infrastructure.csproj" />
  </ItemGroup>

</Project>
